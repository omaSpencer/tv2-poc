# Placeholder only. Not a runnable configuration: replace every REPLACE_ME value.
# ENV_FILE selects exactly one file and there is no fallback to another .env.
# In a normal run the explicit process environment overrides the file.

# --- application ---
NODE_ENV=development
PORT=3000
# Use 0.0.0.0 when listening inside a container.
HOST=127.0.0.1
LOG_LEVEL=info
DATABASE_URL=postgresql://poc:REPLACE_ME@127.0.0.1:5432/poc

# Integrations are off until their verifying adapter exists. Turning one on
# makes its keys mandatory. FEATURE_IDENTITY (M2), FEATURE_OUTBOX_RELAY (M3) and
# FEATURE_SEARCH (M4) have adapters; FEATURE_MEDIA still fails startup when
# enabled.
FEATURE_IDENTITY=off
FEATURE_OUTBOX_RELAY=off
FEATURE_SEARCH=off
FEATURE_MEDIA=off

# --- public edge rate limit (BE-F1 S1) ---
# Applies to GET /catalog/search and GET /catalog/contents/:id only, per route,
# per client, in this process. Health and admin routes are never metered.
RATE_LIMIT_PUBLIC=on
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
# How many reverse proxies in front of the application may be trusted to have
# appended an X-Forwarded-For entry. 0 ignores the header entirely and counts
# the transport peer, which is the right value for local development.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# --- compose (core profile) ---
# BE-F1 S4: published dependency ports bind here. Loopback by default; changing
# it exposes development credentials to the local network.
HOST_BIND_ADDRESS=127.0.0.1
POSTGRES_USER=poc
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=poc
POSTGRES_PORT=5432
# Pin an exact tag or digest here instead of editing compose.yaml. See VERSIONS.md.
# POSTGRES_IMAGE=postgres:17-alpine@sha256:REPLACE_ME

# --- disposable test target (db:reset, integration tests) ---
# The database name must end with a _test marker and must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://poc:REPLACE_ME@127.0.0.1:5432/poc_test

# --- compose (full profile; started by M2-M4, not by the M0 gate) ---
NATS_PORT=4222
NATS_MONITOR_PORT=8222
MEILI_A_PORT=7700
MEILI_B_PORT=7701
MEILI_A_KEY=REPLACE_ME
MEILI_B_KEY=REPLACE_ME
# BE-F1 S7: the local profile runs Meilisearch in development mode on purpose.
# The production posture is compose.prod.yaml + .env.production.example, which
# forces MEILI_ENV=production with a mandatory, non-repository master key.
MEILI_ENV=development
AUTHENTIK_PORT=9000
AUTHENTIK_POSTGRES_PASSWORD=REPLACE_ME
AUTHENTIK_SECRET_KEY=REPLACE_ME
AUTHENTIK_BOOTSTRAP_PASSWORD=REPLACE_ME
AUTHENTIK_BOOTSTRAP_TOKEN=REPLACE_ME
AUTHENTIK_POC_USER_PASSWORD=REPLACE_ME
AUTHENTIK_PUBLIC_URL=http://127.0.0.1:9000

# --- integration keys (M2-M6; required once the matching feature is on) ---
OIDC_ISSUER_URL=http://127.0.0.1:9000/application/o/poc-backend/
OIDC_AUDIENCE=poc-backend-api
OIDC_JWKS_URI=http://127.0.0.1:9000/application/o/poc-backend/jwks/
OIDC_CLOCK_TOLERANCE_S=30
OIDC_HTTP_TIMEOUT_MS=2000
NATS_URL=nats://127.0.0.1:4222
NATS_STREAM=CONTENT
NATS_SUBJECT=poc.content.changed.v1
NATS_PUBLISH_ACK_TIMEOUT_MS=5000
NATS_RELAY_BATCH=100
NATS_RELAY_POLL_MS=1000
# --- search (M4; required once FEATURE_SEARCH=on) ---
# A and B must be two different endpoints. Two URLs that resolve to the same
# Meilisearch process are refused at startup: a single instance cannot
# demonstrate the A/B outage the milestone is built on.
# FEATURE_SEARCH=on also requires NATS_URL, even with the relay off.
MEILI_A_URL=http://127.0.0.1:7700
MEILI_A_KEY=REPLACE_ME
MEILI_B_URL=http://127.0.0.1:7701
MEILI_B_KEY=REPLACE_ME
# Same UID on both instances; their namespaces are separate. Tests and smoke
# runs override it with a unique value so a shared instance stays untouched.
MEILI_INDEX_UID=contents
# Per-instance ceiling for one public search call.
SEARCH_TIMEOUT_MS=1000
# Budget for one polling stretch of a single index task. A timeout here is not
# a task success: the worker keeps the same task UID and polls again.
MEILI_TASK_TIMEOUT_MS=30000
MEILI_TASK_POLL_MS=100
# JetStream working() heartbeat while a task runs; must stay under ack_wait (30 s).
# Heartbeat must be 1–10000 ms and at most one third of the consumer ack_wait.
SEARCH_CONSUMER_WORKING_MS=10000
# --- recovery and reindex (M5) ---
REINDEX_BATCH_SIZE=500
REINDEX_DRAIN_TIMEOUT_MS=30000
REINDEX_IMPORT_TIMEOUT_MS=300000
REINDEX_OWNER_HEARTBEAT_MS=5000
REINDEX_WORKER_STALE_MS=15000
REINDEX_VERIFY_TIMEOUT_MS=30000
CONTENT_WRITE_BARRIER_WAIT_MS=5000
ANTMEDIA_BASE_URL=
ANTMEDIA_TOKEN=
