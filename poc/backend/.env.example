# Placeholder: replace with the local PostgreSQL connection supplied by Compose.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://poc:REPLACE_ME@127.0.0.1:5432/poc
FEATURE_IDENTITY=off
FEATURE_OUTBOX_RELAY=off
FEATURE_SEARCH=off
FEATURE_MEDIA=off
# ENV_FILE selects exactly one file. Process environment overrides its values.
