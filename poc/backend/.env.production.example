# BE-F1 O1 + S7 – production-shaped sample for the compose.prod.yaml overlay.
#
# Placeholder only, and deliberately not runnable: every REPLACE_ME must be
# replaced from a secret store before use. No value in this file is a default
# that would still work if it were left alone, and nothing here may ever be
# committed with a real value. Secrets reach the container as environment at
# run time; they are never build arguments and never image layers.
#
#   docker compose -f compose.yaml -f compose.prod.yaml \
#     --env-file .env.production --profile app --profile full up -d --wait

# --- image ---
# Pin an exact digest once a registry is reachable (external prerequisite E01).
NODE_IMAGE=node:24.20.0-alpine3.22
BACKEND_IMAGE=indaplay-poc-backend:0.0.0
BACKEND_PORT=3000

# --- host exposure (S4) ---
# Loopback by default. Widen it only behind a reverse proxy that terminates TLS
# and enforces the same-origin ingress contract described in README.md.
HOST_BIND_ADDRESS=127.0.0.1

# --- application ---
LOG_LEVEL=info
# Reached over the Compose network, so the host is the service name.
BACKEND_DATABASE_URL=postgresql://poc:REPLACE_ME@postgres:5432/poc
POSTGRES_USER=poc
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=poc

# --- public edge rate limit (S1) ---
RATE_LIMIT_PUBLIC=on
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
# Exactly one reverse proxy in front of the application. Raise this only if a
# second trusted hop is really added: every trusted hop is one more
# X-Forwarded-For entry a client could otherwise forge.
RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# --- integrations ---
FEATURE_IDENTITY=off
FEATURE_OUTBOX_RELAY=off
FEATURE_SEARCH=off
FEATURE_MEDIA=off
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
BACKEND_NATS_URL=nats://nats:4222
NATS_STREAM=CONTENT
NATS_SUBJECT=poc.content.changed.v1

# --- search (S7) ---
# The overlay runs both instances with MEILI_ENV=production, which makes the
# master key mandatory in Meilisearch itself. Two distinct keys, neither of them
# stored in the repository.
BACKEND_MEILI_A_URL=http://meilisearch-a:7700
BACKEND_MEILI_B_URL=http://meilisearch-b:7700
MEILI_A_KEY=REPLACE_ME
MEILI_B_KEY=REPLACE_ME
MEILI_A_PORT=7700
MEILI_B_PORT=7701

# --- authentik (only when the full profile is started) ---
AUTHENTIK_PORT=9000
AUTHENTIK_POSTGRES_PASSWORD=REPLACE_ME
AUTHENTIK_SECRET_KEY=REPLACE_ME
AUTHENTIK_BOOTSTRAP_PASSWORD=REPLACE_ME
AUTHENTIK_BOOTSTRAP_TOKEN=REPLACE_ME
AUTHENTIK_POC_USER_PASSWORD=REPLACE_ME
