{
  "name": "@indaplay/poc-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.json --watch",
    "lint": "oxlint src scripts test",
    "test": "vitest run",
    "test:integration:m1": "vitest run test/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/db-reset.mjs",
    "contracts:emit": "npm run build && node scripts/emit-contracts.mjs",
    "demo:m1": "npm run build && node scripts/demo-m1.mjs",
    "smoke:m0": "node scripts/smoke-m0.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.42.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
