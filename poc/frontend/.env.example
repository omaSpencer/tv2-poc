# Browser-visible. Empty API base = same-origin `/api` (Vite proxy in `npm run dev`).
VITE_API_BASE=/api

# Used only by the Vite dev proxy (not exposed to the browser bundle).
VITE_BACKEND_ORIGIN=http://127.0.0.1:3000

# M2 OIDC / PKCE. Uncomment together when the Authentik full profile is available.
# VITE_OIDC_ISSUER_URL=http://127.0.0.1:9000/application/o/poc-backend/
# VITE_OIDC_CLIENT_ID=poc-backend
# VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5173/login

# Development escape hatch only. A normal build has no manual Bearer input.
VITE_ALLOW_MANUAL_TOKEN=false
