# Browser-visible. Every `VITE_*` value is compiled into the public bundle and
# must not contain credentials, private keys, or other secrets.
VITE_API_BASE=/api

# Vite development proxy target only. Not a production browser secret, not the
# runtime API address the SPA calls (the browser always uses same-origin `/api`).
# An invalid explicit value fails fast. Production builds never fall back to
# http://127.0.0.1:3000 for docs or API links.
VITE_BACKEND_ORIGIN=http://127.0.0.1:3000

# M2 OIDC / PKCE. Uncomment together when the Authentik full profile is available.
# Production builds require the three redirect URIs explicitly.
# VITE_OIDC_ISSUER_URL=http://127.0.0.1:9000/application/o/poc-backend/
# VITE_OIDC_CLIENT_ID=poc-backend
# VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5173/login
# VITE_OIDC_SILENT_REDIRECT_URI=http://127.0.0.1:5173/auth/silent-callback

# Development escape hatch only. Production build fails if this is true.
VITE_ALLOW_MANUAL_TOKEN=false
