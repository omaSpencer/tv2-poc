{
  "name": "@indaplay/poc-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "compiler:check": "node scripts/check-react-compiler.mjs",
    "contracts:generate": "openapi-typescript ../contracts/backend.openapi.json -o src/api/generated/backend.ts",
    "contracts:check": "node scripts/check-contracts.mjs",
    "lint": "oxlint src e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "npm run contracts:check && npm run build && npm run compiler:check && npm run lint && npm run test",
    "e2e": "npm run e2e:typecheck && playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e/.report/html",
    "e2e:install": "playwright install chromium",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "oidc-client-ts": "3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0-rc.4",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
